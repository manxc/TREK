TREK_IMAGE_TAG=3.4.1-family-zh-en-baidu.1
TREK_LOCAL_PORT=3030
APP_URL=https://trek.jiqiao.ai
ALLOWED_ORIGINS=https://trek.jiqiao.ai,https://trek.xinyi.dev
WEBAUTHN_RP_ID=trek.jiqiao.ai
WEBAUTHN_ORIGINS=https://trek.jiqiao.ai

CLOUDFLARED_TUNNEL_ID=replace-with-tunnel-uuid
CLOUDFLARED_CREDENTIALS_FILE=/Users/you/.cloudflared/replace-with-tunnel-uuid.json
TREK_BACKUP_ROOT=/Users/you/Backups/TREK

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# Used only when the database is empty. Change the password after first login.
ADMIN_EMAIL=admin@trek.local
ADMIN_PASSWORD=replace-with-a-strong-unique-password
